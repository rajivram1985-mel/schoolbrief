# Anthropic — https://console.anthropic.com
ANTHROPIC_API_KEY=sk-ant-...

# Supabase — Project Settings → API
SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_SERVICE_ROLE_KEY=eyJ...
SUPABASE_ANON_KEY=eyJ...

# App URL — used for magic link redirect (no trailing slash)
# Dev: http://localhost:3000  |  Prod: https://your-vercel-domain.vercel.app
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Postmark — Server → API Tokens
POSTMARK_SERVER_TOKEN=your-server-token-here

# Postmark — the From address you've verified in Postmark
POSTMARK_FROM_EMAIL=hello@getschoolbrief.com

# Postmark — inbound stream hash (shows in the inbound address, e.g. abc123@inbound.postmarkapp.com)
# Only needed for documentation; the webhook URL uses this hash
POSTMARK_INBOUND_HASH=abc123

# Postmark — full inbound address shown to parents in onboarding Step 3
# Format: your-hash@inbound.postmarkapp.com
POSTMARK_INBOUND_ADDRESS=abc123@inbound.postmarkapp.com
